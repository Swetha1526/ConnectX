# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide your MongoDB connection string (e.g. mongodb://localhost:27017/connectx or MongoDB Atlas URI)
# If left empty, ConnectX will start an embedded in-memory MongoDB instance automatically for development & testing!
MONGO_URI=mongodb://127.0.0.1:27017/connectx

# JWT Secret Key
JWT_SECRET=connectx_super_secret_jwt_key_2026_guvi_major_project

# Cloudinary Configuration (Optional - falls back to secure local static storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
